# Source maps
dist/*.*.map
**/*.map

# Orphaned Font Awesome 4 webfonts — no shipped CSS or JS references these.
# Only the FA5 faces (fa-solid-900 / fa-brands-400 / fa-regular-400) are used,
# by assets/css/font-awesome5.css.
assets/fonts/FontAwesome.otf
assets/fonts/fontawesome-webfont.eot
assets/fonts/fontawesome-webfont.svg
assets/fonts/fontawesome-webfont.ttf
assets/fonts/fontawesome-webfont.woff
assets/fonts/fontawesome-webfont.woff2

# Dead-browser font formats. font-awesome5.css still lists these in its src:
# fallback chain, but every browser resolves woff2/woff first and never fetches
# them: .eot is IE-only (IE11 EOL June 2022), .svg fonts are Safari <=4 /
# iOS <=4.3 / Android <=4.3.
assets/fonts/fa-solid-900.eot
assets/fonts/fa-solid-900.svg
assets/fonts/fa-brands-400.eot
assets/fonts/fa-brands-400.svg
assets/fonts/fa-regular-400.eot
assets/fonts/fa-regular-400.svg

# Docs & repo assets
README.md
readme.md
compatibility-report.md
changes.txt
.wordpress-org

# Archives & dumps
*.sql
*.tar.gz
*.zip
*.tgz
**/*.zip
*.log
